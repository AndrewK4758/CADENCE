"""Enterprise Antigravity Local AI Offload MCP Server (:11434).

Delivers token-minimal, zero-context-loss execution briefs to frontier (Argon)
and local (`inference`) models via:
1. Boundary-aware AST/section semantic chunking + symbol maps (`local_semantic_embed`).
2. Deduplicated, width-bounded log triage with fast-path bypass (`offload_log_triage`).
3. Semantically focused, delta-only CADENCE pillar pre-review (`offload_deep_review`).
"""

from __future__ import annotations
import glob as glob_mod, json, math, os, pathlib, re, subprocess, time, urllib.request
from typing import Any
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("local-offload")
HOME_STR = str(pathlib.Path.home())
os.environ["PATH"] = f"{HOME_STR}/.local/bin:{HOME_STR}/.asdf/shims:{HOME_STR}/.asdf/bin:{os.environ.get('PATH', '')}"
LLAMA_SWAP_URL = os.environ.get("LLAMA_SWAP_URL", "http://127.0.0.1:11434/v1")
TIER1_CPU_URL = os.environ.get("LOCAL_AI_TIER1_URL", LLAMA_SWAP_URL)
TIER2_GPU_URL = os.environ.get("LOCAL_AI_TIER2_URL", LLAMA_SWAP_URL)
RAW_TRIAGE_LOG_PATH = pathlib.Path("/tmp/agy-last-triage.log")
RAW_TRIAGE_DIR = pathlib.Path("/tmp/agy-triage")
REPO_PATH_RE = re.compile(rf"(?:{re.escape(HOME_STR)}/projects/|~/projects/|-C\s+|cd\s+)([A-Za-z0-9_./~-]+)")
TIER2_MODELS = {
    "inference", "inference-dual", "openai/inference", "openai/inference-dual", "openai/fast-cpu",
    "gemma-4-26b-dual", "local-moe-hybrid", "gemma-4-26b-a4b", "26b-a4b", "gemma-4-26b", "local-12b-gpu",
    "gemma-4-12b", "12b", "local-fast-cpu", "fast-cpu", "gemma-4-e2b", "e2b", "litert", "litert-gemma",
}
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "bin", "obj", "dist", "build", "__pycache__", ".next", "target"}
TEXT_EXTS = {".py", ".sh", ".zsh", ".bash", ".md", ".json", ".yaml", ".yml", ".toml", ".ini", ".ts", ".tsx", ".js", ".jsx", ".cs", ".rs", ".go", ".c", ".cpp", ".h", ".sql", ".service"}
VERBATIM_SIGNAL_RE = re.compile(
    r"(?i)(\b(?:error|warning|warn|fail(?:ed|ure)?|exception|traceback|assert(?:ion)?|panic|fatal|coverage|passed|skipped)\b"
    r"|[A-Za-z0-9_./-]+\.[A-Za-z0-9_]+:\d+(?::\d+)?)"
)
SYMBOL_RE = re.compile(
    r"^\s*(?:async\s+def|def|class|function|export\s+(?:async\s+)?function|export\s+(?:class|interface|type|const)|"
    r"interface|struct|enum|pub\s+(?:async\s+)?fn|fn|impl|#{1,3})\s+([A-Za-z0-9_./:-]+)"
    r"|^([A-Za-z0-9_-]+)\s*\(\)\s*\{|^([A-Za-z0-9_.-]+):\s*$"
)
CHORD_SEAMS = ("UNSOUND_CONDITION", "RULE_DIVERGENCE", "BOUNDARY_FAULT", "DELTA_AUDIT_GAP")
NORM_DUP_RE = re.compile(r"^\s*\d+\s*\|\s*(?:[A-Z][a-z]{2}\s+\d+\s+\d+:\d+:\d+\s+\S+\s+\S+?\[\d+\]:\s*)?")


def _resolve_base_url(model: str) -> str:
    return TIER2_GPU_URL if model in TIER2_MODELS else TIER1_CPU_URL

def _post_json(url: str, payload: dict[str, Any], timeout: float = 180.0) -> dict[str, Any]:
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))

def _cosine_similarity(a: list[float], b: list[float]) -> float:
    dot = sum(x * y for x, y in zip(a, b))
    na, nb = math.sqrt(sum(x * x for x in a)), math.sqrt(sum(y * y for y in b))
    return dot / (na * nb) if na and nb else 0.0


def _detect_repo_name(hint: str) -> str:
    cands = [os.path.expanduser(m.group(1)) for m in REPO_PATH_RE.finditer(hint)] + [os.getcwd()]
    for raw in cands:
        p = pathlib.Path(raw)
        cur = p if p.is_dir() else p.parent
        for d in (cur, *cur.parents):
            if (d / ".git").exists():
                return re.sub(r"[^A-Za-z0-9._-]", "_", d.name)
        m = re.search(r"/projects/([A-Za-z0-9._-]+)", str(p))
        if m:
            return m.group(1)
    return re.sub(r"[^A-Za-z0-9._-]", "_", pathlib.Path.cwd().name or "global")


def _clip_line(nline: str, log_path: pathlib.Path = RAW_TRIAGE_LOG_PATH, limit: int = 320) -> str:
    if len(nline) <= limit:
        return nline
    m = VERBATIM_SIGNAL_RE.search(nline)
    if not m or m.start() < limit // 2:
        return f"{nline[:limit]} ...[+{len(nline) - limit} chars in {log_path}]"
    start = max(10, m.start() - 80)
    end = min(len(nline), start + limit - 20)
    return f"{nline[:10]}...{nline[start:end]}...[+{len(nline) - end} chars in {log_path}]"


def _compact_signals(numbered_lines: list[str], log_path: pathlib.Path = RAW_TRIAGE_LOG_PATH) -> tuple[list[str], set[int]]:
    groups: dict[str, dict[str, Any]] = {}
    matched: set[int] = set()
    for idx, nline in enumerate(numbered_lines, start=1):
        if not VERBATIM_SIGNAL_RE.search(nline):
            continue
        matched.add(idx)
        key = NORM_DUP_RE.sub("", nline)[:200]
        if key not in groups:
            groups[key] = {"line": _clip_line(nline, log_path), "count": 1, "first": idx, "last": idx}
        else:
            groups[key]["count"] += 1
            groups[key]["last"] = idx
    out = [
        f"{g['line']}  [x{g['count']} occurrences, lines {g['first']}..{g['last']}]" if g["count"] > 1 else g["line"]
        for g in groups.values()
    ]
    return out, matched


def _write_numbered_raw_log(raw_text: str, source_header: str, repo_name: str, pid: str | int) -> tuple[int, list[str], pathlib.Path]:
    lines = raw_text.splitlines()
    numbered = [f"{idx:6d} | {line}" for idx, line in enumerate(lines, start=1)]
    repo_dir = RAW_TRIAGE_DIR / repo_name
    repo_dir.mkdir(parents=True, exist_ok=True)
    log_path = repo_dir / f"{pid}.log"
    header = (
        f"# {log_path} — Full Unedited Output (CADENCE SDLC Ephemeral Session Escape Hatch)\n"
        f"# Repo: {repo_name} | PID: {pid} | Source: {source_header} | Total Lines: {len(lines)}\n"
        f"# ------------------------------------------------------------------------------\n"
    )
    payload = header + "\n".join(numbered) + "\n"
    log_path.write_text(payload, encoding="utf-8")
    log_path.chmod(0o600)
    latest_link, tmp_link = repo_dir / "latest.log", repo_dir / f".latest.log.{pid}"
    tmp_last = RAW_TRIAGE_LOG_PATH.with_name(f".agy-last-triage.log.{pid}")
    try:
        tmp_link.unlink(missing_ok=True)
        tmp_link.symlink_to(log_path)
        tmp_link.replace(latest_link)
        tmp_last.write_text(payload, encoding="utf-8")
        tmp_last.chmod(0o600)
        tmp_last.replace(RAW_TRIAGE_LOG_PATH)
    except OSError:
        for f in (tmp_link, tmp_last):
            f.unlink(missing_ok=True)
    return len(lines), numbered, log_path


def _extract_file_chunks(p: pathlib.Path, chunk_lines: int = 48, overlap: int = 4) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    text = p.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    total = len(lines)
    symbols: list[tuple[int, str]] = []
    for idx, raw in enumerate(lines, start=1):
        m = SYMBOL_RE.match(raw)
        if m:
            sym = next((g for g in m.groups() if g), "").strip()
            if sym and len(sym) <= 64:
                symbols.append((idx, sym))
    meta = {
        "path": str(p), "name": p.name, "lines": total,
        "ergonomics": "OK (<400)" if total < 400 else f"EXCEEDS_400 ({total})",
        "symbols": [f"{s}@L{ln}" for ln, s in symbols[:24]],
        "seams": [s for s in CHORD_SEAMS if s in text],
    }
    if total == 0:
        return meta, []
    bounds = [ln for ln, _ in symbols if ln > 1]
    chunks: list[dict[str, Any]] = []
    start = 1
    while start <= total:
        end = min(total, start + chunk_lines - 1)
        for b in bounds:
            if start + 14 <= b <= end + 6:
                end = max(start, b - 1)
                break
        slice_lines = lines[start - 1 : end]
        c_syms = [f"{s}@L{ln}" for ln, s in symbols if start <= ln <= end]
        numbered = "\n".join(f"{i:4d} | {l[:220]}" for i, l in enumerate(slice_lines, start=start))
        embed_body = "\n".join(l[:240] for l in slice_lines)[:4500]
        chunks.append({
            "label": f"{p}#L{start}-L{end}", "path": str(p), "name": p.name,
            "start": start, "end": end, "symbols": c_syms, "numbered": numbered,
            "embed_text": f"search_document: {p.name} L{start}-L{end} symbols={','.join(c_syms)}\n{embed_body}",
        })
        if end >= total:
            break
        start = max(start + 1, end + 1 - overlap)
    return meta, chunks


def _expand_targets(texts: list[str], max_files: int = 40) -> tuple[dict[str, dict[str, Any]], list[dict[str, Any]]]:
    file_metas: dict[str, dict[str, Any]] = {}
    chunks: list[dict[str, Any]] = []
    seen: set[str] = set()

    def _add(fp: pathlib.Path) -> None:
        res = str(fp.resolve())
        if res in seen or len(seen) >= max_files or not fp.is_file() or fp.stat().st_size > 512_000:
            return
        seen.add(res)
        meta, fchunks = _extract_file_chunks(fp)
        file_metas[str(fp)] = meta
        chunks.extend(fchunks)

    for idx, item in enumerate(texts):
        s = item.strip()
        if "\n" not in s and len(s) < 1024:
            exp = os.path.expanduser(s)
            p = pathlib.Path(exp)
            if p.is_file():
                _add(p)
                continue
            if p.is_dir():
                for root, dirs, files in os.walk(p):
                    dirs[:] = [d for d in sorted(dirs) if d not in SKIP_DIRS and not d.startswith(".")]
                    for fn in sorted(files):
                        fp = pathlib.Path(root) / fn
                        if fp.suffix.lower() in TEXT_EXTS or fn in {"SKILL.md", "GEMINI.md", "AGENTS.md", "CADENCE_ORG.md"}:
                            _add(fp)
                continue
            if any(ch in exp for ch in "*?[]"):
                for mp in sorted(glob_mod.glob(exp, recursive=True)):
                    _add(pathlib.Path(mp))
                continue
        lines = s.splitlines()
        chunks.append({
            "label": f"snippet[{idx}]", "path": f"snippet[{idx}]", "name": f"snippet[{idx}]",
            "start": 1, "end": max(1, len(lines)), "symbols": [],
            "numbered": "\n".join(f"{i:4d} | {l[:220]}" for i, l in enumerate(lines[:40], start=1)),
            "embed_text": f"search_document: snippet[{idx}]\n{s[:4500]}",
        })
    return file_metas, chunks


def _embed_batch(inputs: list[str], batch_size: int = 48) -> list[list[float]]:
    base_url = _resolve_base_url("embedding")
    vecs: list[list[float]] = []
    for i in range(0, len(inputs), batch_size):
        resp = _post_json(f"{base_url}/embeddings", {"model": "embedding", "input": inputs[i : i + batch_size]}, timeout=60.0)
        vecs.extend(r["embedding"] for r in sorted(resp["data"], key=lambda r: r["index"]))
    return vecs


@mcp.tool()
def offload_log_triage(log_text_or_command: str, model: str = "inference") -> str:
    """Offload build/test/diagnostic logs to llama-swap (:11434) with deduplicated signal compaction."""
    source_desc, raw_text, exit_code_info = "inline log text", log_text_or_command, "N/A"
    stripped = log_text_or_command.strip()
    pid: str | int = f"{os.getpid()}-{time.time_ns() % 100000}"
    if stripped.startswith("cmd:"):
        cmd_str = stripped[4:].strip()
        source_desc = f"command: `{cmd_str}`"
        proc = subprocess.Popen(cmd_str, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        pid = proc.pid
        out, _ = proc.communicate(timeout=300)
        raw_text, exit_code_info = out or "", str(proc.returncode)
    elif "\n" not in stripped and len(stripped) < 1024:
        cand = pathlib.Path(stripped).expanduser()
        if cand.is_file():
            source_desc, raw_text, exit_code_info = f"file: `{cand}`", cand.read_text(encoding="utf-8", errors="replace"), "file"

    repo_name = _detect_repo_name(stripped)
    total_lines, numbered_lines, log_path = _write_numbered_raw_log(raw_text, source_desc, repo_name, pid)
    compacted_signals, matched_indices = _compact_signals(numbered_lines, log_path)

    if exit_code_info in {"0", "file", "N/A"} and total_lines <= 30 and not compacted_signals:
        preview = "\n".join(_clip_line(l, log_path) for l in numbered_lines) if numbered_lines else "(empty output)"
        return (
            f"### Local Offload Log Triage (fast-path, 0 ms LLM overhead)\n"
            f"- **Source**: {source_desc} | **Exit**: `{exit_code_info}` | **Raw**: `{log_path}` (`{total_lines}` lines)\n"
            f"```text\n{preview}\n```\n"
        )

    signal_block = "\n".join(compacted_signals[:60]) if compacted_signals else "(No error/warning patterns matched)"
    unmatched_tail = [_clip_line(numbered_lines[i - 1], log_path) for i in range(max(1, total_lines - 35), total_lines + 1) if i not in matched_indices]
    tail_block = "\n".join(unmatched_tail[-25:]) if unmatched_tail else "(All tail lines included in signals above)"

    t0 = time.perf_counter()
    resp = _post_json(
        f"{_resolve_base_url(model)}/chat/completions",
        {
            "model": model,
            "messages": [
                {
                    "role": "system",
                    "content": (
                        "You are a token-minimal CADENCE Log Triage Coprocessor. Do NOT repeat raw log lines. "
                        "Output ONLY 3 concise bullet lines: (1) Status & Metrics, (2) Root Cause, (3) Action Targets (`file:line`)."
                    ),
                },
                {
                    "role": "user",
                    "content": f"Source: {source_desc} | Exit: {exit_code_info} | Lines: {total_lines}\n=== SIGNALS ===\n{signal_block}\n=== TAIL ===\n{tail_block}",
                },
            ],
            "max_tokens": 320, "temperature": 0.0, "chat_template_kwargs": {"enable_thinking": False},
        },
        timeout=90.0,
    )
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    summary = resp["choices"][0]["message"].get("content", "").strip()
    sig_out = "\n".join(compacted_signals[:30]) if compacted_signals else "\n".join(unmatched_tail[-15:])
    return (
        f"### Local Offload Log Triage (`{model}`, {elapsed_ms:.0f} ms)\n"
        f"- **Source**: {source_desc} | **Exit**: `{exit_code_info}` | **Raw**: `{log_path}` (`{total_lines}` lines)\n"
        f"```text\n{sig_out}\n```\n{summary}\n"
    )


@mcp.tool()
def offload_deep_review(prompt: str, context_files: list[str] | None = None, model: str = "inference") -> str:
    """Delegate token-minimal CADENCE pillar review or analysis to warm `inference` (:11434)."""
    static_rows, file_blocks = [], []
    for fpath in context_files or []:
        p = pathlib.Path(fpath).expanduser()
        if not p.is_file():
            static_rows.append(f"- `{fpath}`: NOT_FOUND")
            continue
        meta, fchunks = _extract_file_chunks(p, chunk_lines=55, overlap=5)
        seams_str = ",".join(meta["seams"]) if meta["seams"] else "none"
        syms_str = ", ".join(meta["symbols"][:12]) or "none"
        static_rows.append(
            f"- [{meta['name']}](file://{meta['path']}): `{meta['lines']}` lines (`{meta['ergonomics']}`) | CHORD: `{seams_str}` | Symbols: `{syms_str}`"
        )
        if meta["lines"] <= 160 or len(fchunks) <= 3:
            lines = p.read_text(encoding="utf-8", errors="replace").splitlines()
            numbered = "\n".join(f"{i:4d} | {l[:220]}" for i, l in enumerate(lines, start=1))
            file_blocks.append(f"--- {meta['path']} (full, {meta['lines']} lines) ---\n{numbered}")
        else:
            vecs = _embed_batch([f"search_query: {prompt}"] + [c["embed_text"] for c in fchunks])
            qvec, cvecs = vecs[0], vecs[1:]
            ranked = sorted(zip(fchunks, cvecs), key=lambda x: _cosine_similarity(qvec, x[1]), reverse=True)[:3]
            ranked.sort(key=lambda x: x[0]["start"])
            slices = "\n...\n".join(c["numbered"] for c, _ in ranked)
            file_blocks.append(f"--- {meta['path']} ({meta['lines']}L; top-3 semantic slices; symbols: {syms_str}) ---\n{slices}")

    static_summary = "\n".join(static_rows) if static_rows else "- (No context files provided)"
    context_blob = "\n\n".join(file_blocks) if file_blocks else "(No context files)"
    t0 = time.perf_counter()
    resp = _post_json(
        f"{_resolve_base_url(model)}/chat/completions",
        {
            "model": model,
            "messages": [
                {
                    "role": "system",
                    "content": (
                        "You are a token-minimal CADENCE Pre-Review Coprocessor for Gemini 4 Argon. Output ONLY:\n"
                        "1. Actionable findings: `- **[Pillar]** `file:line` — defect/risk -> minimal fix`.\n"
                        "2. One compact line summarizing passing pillars (Data/Audit, Security, Surface, Simplicity/Resilience, Ergonomics <400L)."
                    ),
                },
                {"role": "user", "content": f"### Task\n{prompt}\n\n### Static Telemetry\n{static_summary}\n\n### Focused Code\n{context_blob}"},
            ],
            "max_tokens": 640, "temperature": 0.1, "chat_template_kwargs": {"enable_thinking": False},
        },
        timeout=180.0,
    )
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    return f"### Local Deep Review (`{model}`, {elapsed_ms:.0f} ms)\n{static_summary}\n\n{resp['choices'][0]['message'].get('content', '').strip()}\n"


@mcp.tool()
def local_semantic_embed(texts: list[str], query: str, top_k: int = 5) -> str:
    """Compute zero-VRAM AST/section-chunked semantic search on `nomic-embed-text` (:11434, 8192-ctx)."""
    if not texts:
        return "No texts, files, or directories provided to `local_semantic_embed`."
    t0 = time.perf_counter()
    file_metas, chunks = _expand_targets(texts)
    if not chunks:
        return "No indexable text chunks found in provided targets."

    vecs = _embed_batch([f"search_query: {query}"] + [c["embed_text"] for c in chunks])
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    qvec, cvecs = vecs[0], vecs[1:]
    scored = sorted(((_cosine_similarity(qvec, vec), chunk) for chunk, vec in zip(chunks, cvecs)), key=lambda x: x[0], reverse=True)
    top = scored[: max(1, top_k)]

    out = [
        f"### LiteRT Semantic Execution Pack (`nomic-embed-text`, {elapsed_ms:.1f} ms, 0 MB VRAM, `{len(chunks)}` chunks across `{len(file_metas) or len(texts)}` targets)",
        f"- **Query**: `{query}`\n",
        "| Rank | Score | Target Coordinate | File Ergonomics | Chunk Symbols |",
        "| :--- | :--- | :--- | :--- | :--- |",
    ]
    for rank, (score, c) in enumerate(top, start=1):
        fmeta = file_metas.get(c["path"])
        ergo = fmeta["ergonomics"] if fmeta else f"{c['end']}L"
        csyms = ", ".join(c["symbols"][:4]) if c["symbols"] else "(body)"
        link = f"[{c['name']}#L{c['start']}-L{c['end']}](file://{c['path']}#L{c['start']}-L{c['end']})" if fmeta else f"`{c['label']}`"
        out.append(f"| {rank} | `{score:.4f}` | {link} | `{ergo}` | `{csyms}` |")

    out.append("\n#### Pinned Context Slices & File Structural Maps (Immediate Execution Ready)")
    seen_meta: set[str] = set()
    for rank, (score, c) in enumerate(top[: min(3, len(top))], start=1):
        fmeta = file_metas.get(c["path"])
        hdr = f"**[{rank}] [{c['name']}#L{c['start']}-L{c['end']}](file://{c['path']}#L{c['start']}-L{c['end']})** (`score={score:.4f}`)"
        if fmeta and c["path"] not in seen_meta:
            seen_meta.add(c["path"])
            all_syms = ", ".join(fmeta["symbols"]) if fmeta["symbols"] else "none"
            seams = ", ".join(fmeta["seams"]) if fmeta["seams"] else "none"
            hdr += f"\n- *File Map (`{fmeta['lines']}` lines, `{fmeta['ergonomics']}`, CHORD seams: `{seams}`)*: `{all_syms}`"
        out.append(f"{hdr}\n```text\n{c['numbered']}\n```")
    return "\n".join(out) + "\n"


if __name__ == "__main__":
    mcp.run()
