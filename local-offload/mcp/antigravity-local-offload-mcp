"""Enterprise Antigravity Local AI Offload MCP Server (:11434).

Delivers token-minimal, inline-bounded (<3.9 KB) execution briefs to frontier
and local models without triggering Antigravity MCP file-spill traps:
1. Boundary-aware AST/section semantic chunking + symbol maps (`local_semantic_embed`).
2. Deduplicated, context-preserving log triage with 30-line fast-path (`offload_log_triage`).
3. Diff-aware, deterministic-plus-LLM pre-review (`offload_deep_review`).
"""

from __future__ import annotations

import os
import pathlib
import re
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mcp.server.fastmcp import FastMCP  # noqa: E402
import offload_core as core  # noqa: E402

mcp = FastMCP("local-offload")
os.environ["PATH"] = f"{core.HOME_STR}/.local/bin:{core.HOME_STR}/.asdf/shims:{core.HOME_STR}/.asdf/bin:{os.environ.get('PATH', '')}"


@mcp.tool()
def offload_log_triage(log_text_or_command: str, model: str = core.DEFAULT_OFFLOAD_MODEL, cwd: str | None = None) -> str:
    """Offload build/test/diagnostic logs to llama-swap (:11434) with deduplicated signal compaction."""
    source_desc, raw_text, exit_code_info = "inline log text", log_text_or_command, "N/A"
    stripped = log_text_or_command.strip()
    pid: str | int = f"{os.getpid()}-{time.time_ns() % 100000}"
    work_dir: pathlib.Path | None = None
    if cwd:
        work_dir = pathlib.Path(cwd).expanduser()
        if not work_dir.is_dir():
            return f"ERROR: `offload_log_triage` cwd does not exist: `{cwd}`"

    if stripped.startswith("cmd:"):
        cmd_str = stripped[4:].strip()
        source_desc = f"command: `{cmd_str}`"
        proc = subprocess.Popen(
            cmd_str,
            shell=True,
            cwd=str(work_dir) if work_dir else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        pid = proc.pid
        out, _ = proc.communicate(timeout=300)
        raw_text, exit_code_info = out or "", str(proc.returncode)
    elif "\n" not in stripped and len(stripped) < 1024:
        cand = pathlib.Path(stripped).expanduser()
        if not cand.is_absolute() and work_dir:
            cand = work_dir / cand
        if cand.is_file():
            source_desc, raw_text, exit_code_info = f"file: `{cand}`", cand.read_text(encoding="utf-8", errors="replace"), "file"

    repo_name = core.detect_repo_name(stripped, str(work_dir) if work_dir else None)
    total_lines, numbered_lines, log_path = core.write_numbered_raw_log(raw_text, source_desc, repo_name, pid)
    compacted_signals, matched_indices, has_fail = core.compact_signals(numbered_lines, log_path)

    if total_lines <= 30 or (exit_code_info in {"0", "file", "N/A"} and total_lines <= 55 and not has_fail):
        preview = "\n".join(core.clip_line(l, log_path) for l in numbered_lines) if numbered_lines else "(empty output)"
        hdr = f"### Local Offload Log Triage (fast-path, 0 ms LLM overhead)\n- **Source**: {source_desc} | **Exit**: `{exit_code_info}` | **Raw**: `{log_path}` (`{total_lines}` lines)\n```text\n{preview}\n```"
        return core.fit_inline(hdr)

    signal_block = "\n".join(compacted_signals[:45]) if compacted_signals else "(No error/warning patterns matched)"
    unmatched_tail = [core.clip_line(numbered_lines[i - 1], log_path) for i in range(max(1, total_lines - 30), total_lines + 1) if i not in matched_indices]
    tail_block = "\n".join(unmatched_tail[-20:]) if unmatched_tail else "(All tail lines included in signals above)"
    t0 = time.perf_counter()
    sys_msg = "You are a token-minimal Log Triage Coprocessor. Do NOT repeat raw log lines. Output ONLY 3 concise bullet lines: (1) Status & Metrics, (2) Exact Root Cause (ignore non-blocking warnings if tests/build succeeded), (3) Action Targets (`file:line`)."
    usr_msg = f"Source: {source_desc} | Exit: {exit_code_info} | Lines: {total_lines}\n=== SIGNALS ===\n{signal_block}\n=== TAIL ===\n{tail_block}"
    resp = core.post_json(
        f"{core.resolve_base_url(model)}/chat/completions",
        {
            "model": model,
            "messages": [{"role": "system", "content": sys_msg}, {"role": "user", "content": usr_msg}],
            "max_tokens": 320,
            "temperature": 0.0,
            "chat_template_kwargs": {"enable_thinking": False},
        },
        timeout=90.0,
    )
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    summary = resp["choices"][0]["message"].get("content", "").strip()
    sig_out = "\n".join(compacted_signals[:24]) if compacted_signals else "\n".join(unmatched_tail[-15:])
    body = f"### Local Offload Log Triage (`{model}`, {elapsed_ms:.0f} ms)\n- **Source**: {source_desc} | **Exit**: `{exit_code_info}` | **Raw**: `{log_path}` (`{total_lines}` lines)\n```text\n{sig_out}\n```"
    return core.fit_inline(body, footer=summary)


@mcp.tool()
def offload_deep_review(
    prompt: str,
    context_files: list[str] | None = None,
    model: str = core.DEFAULT_OFFLOAD_MODEL,
    diff_range: str | None = None,
    cwd: str | None = None,
) -> str:
    """Delegate diff-aware mechanical & CADENCE pillar pre-review to warm `inference` (:11434)."""
    work_dir = pathlib.Path(cwd).expanduser() if cwd else pathlib.Path.cwd()
    if cwd and not work_dir.is_dir():
        return f"ERROR: `offload_deep_review` cwd does not exist: `{cwd}`"

    static_rows, file_blocks, det_flags = [], [], []
    if diff_range:
        try:
            d_rows, d_flags, d_blocks = core.collect_git_diff_context(diff_range, work_dir)
            static_rows.extend(d_rows)
            det_flags.extend(d_flags)
            for blk in d_blocks:
                file_blocks.append(f"--- git diff {diff_range} ---\n{blk}")
        except Exception as exc:
            return f"ERROR: `offload_deep_review` diff collection failed: {exc}"

    for fpath in context_files or []:
        p = pathlib.Path(fpath).expanduser()
        if not p.is_absolute():
            p = work_dir / p
        if not p.is_file():
            static_rows.append(f"- `{fpath}`: NOT_FOUND")
            continue
        meta, fchunks = core.extract_file_chunks(p, chunk_lines=50, overlap=4)
        seams_str, syms_str = (",".join(meta["seams"]) or "none"), (", ".join(meta["symbols"][:10]) or "none")
        seam_note = f" | Seams: `{seams_str}`" if meta["seams"] else ""
        static_rows.append(f"- [{meta['name']}](file://{meta['path']}): `{meta['lines']}` lines (`{meta['ergonomics']}`){seam_note} | Symbols: `{syms_str}`")
        if meta["lines"] >= 400:
            det_flags.append(f"EXCEEDS_400: {p} ({meta['lines']} lines)")
        if meta["lines"] <= 160 or len(fchunks) <= 3:
            lines = p.read_text(encoding="utf-8", errors="replace").splitlines()
            numbered = "\n".join(f"{i:4d} | {l[:220]}" for i, l in enumerate(lines, start=1))
            file_blocks.append(f"--- {meta['path']} (full, {meta['lines']} lines) ---\n{numbered}")
        else:
            vecs = core.embed_batch([f"task: code retrieval | query: {prompt}"] + [c["embed_text"] for c in fchunks])
            qvec, cvecs = vecs[0], vecs[1:]
            ranked = sorted(zip(fchunks, cvecs), key=lambda x: core.cosine_similarity(qvec, x[1]), reverse=True)[:3]
            ranked.sort(key=lambda x: x[0]["start"])
            file_blocks.append(f"--- {meta['path']} ({meta['lines']}L; top-3 semantic slices; symbols: {syms_str}) ---\n" + "\n...\n".join(c["numbered"] for c, _ in ranked))

    flag_hdr = ("\n- **Deterministic Flags**: " + "; ".join(det_flags[:8])) if det_flags else ""
    static_summary = ("\n".join(static_rows) if static_rows else "- (No diff or context files provided)") + flag_hdr
    context_blob = "\n\n".join(file_blocks) if file_blocks else "(No diff or context files)"
    t0 = time.perf_counter()
    sys_msg = (
        "You are a token-minimal CADENCE Pre-Review Coprocessor. Output ONLY:\n"
        "1. Actionable findings: `- **[Category]** `file:line` — defect/risk/policy/ADR drift -> minimal fix`.\n"
        "2. One compact line summarizing passing checks (Data/Audit, Security, Surface/API, Simplicity/Resilience, Size/ADRs)."
    )
    resp = core.post_json(
        f"{core.resolve_base_url(model)}/chat/completions",
        {
            "model": model,
            "messages": [{"role": "system", "content": sys_msg}, {"role": "user", "content": f"### Task\n{prompt}\n\n### Static Telemetry\n{static_summary}\n\n### Focused Diff & Code\n{context_blob}"}],
            "max_tokens": 900,
            "temperature": 0.1,
            "chat_template_kwargs": {"enable_thinking": False},
        },
        timeout=180.0,
    )
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    llm_body = resp["choices"][0]["message"].get("content", "").strip() or "(No findings returned)"
    disp_rows = static_rows[:8] + ([f"- *... and {len(static_rows) - 8} more file(s)*"] if len(static_rows) > 8 else [])
    disp_static = ("\n".join(disp_rows) if disp_rows else "- (No diff or context files provided)")
    return core.fit_inline(f"### Local Deep Review (`{model}`, {elapsed_ms:.0f} ms){flag_hdr}\n\n{llm_body}\n\n**Scope Metrics:**\n{disp_static}")


@mcp.tool()
def local_semantic_embed(texts: list[str], query: str, top_k: int = 6) -> str:
    """Compute GPU-accelerated AST/section-chunked semantic search on `embeddinggemma-2` (:11434, 8192-ctx)."""
    if not texts:
        return "No texts, files, or directories provided to `local_semantic_embed`."
    t0 = time.perf_counter()
    file_metas, chunks, stats = core.expand_targets(texts)
    if not chunks:
        return "No indexable text chunks found in provided targets."
    vecs = core.embed_batch([f"task: code retrieval | query: {query}"] + [c["embed_text"] for c in chunks])
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    qvec, cvecs, qlow = vecs[0], vecs[1:], query.lower()

    def _sym_match(sym_entry: str) -> float:
        sname = sym_entry.split("@")[0]
        if len(sname) <= 3:
            return 0.0
        if sname.lower() in qlow:
            return 0.10
        parts = [w.lower() for w in re.findall(r"[A-Z]?[a-z0-9]+|[A-Z]+(?=[A-Z]|$)", sname) if len(w) >= 4]
        return 0.08 if sum(1 for p in parts if p[:5] in qlow) >= 2 else 0.0

    def _score(c: dict[str, Any], vec: list[float]) -> float:
        is_test = "_test." in c["name"] or ".test." in c["name"]
        s_boost = 0.0 if is_test else max((_sym_match(s) for s in c["symbols"]), default=0.0)
        return core.cosine_similarity(qvec, vec) + s_boost + (-0.08 if is_test else 0.04)

    scored = sorted(((_score(c, vec), c) for c, vec in zip(chunks, cvecs)), key=lambda x: x[0], reverse=True)
    top = scored[: min(max(1, top_k), 8)]
    trunc_note = (
        f"\n- **WARNING**: Indexed `{stats['indexed']}/{stats['eligible']}` files (`{stats['truncated']}` omitted past file cap; narrow directory paths to inspect omitted files)."
        if stats["truncated"] > 0 else ""
    )
    out = [
        f"### Local Semantic Execution Pack (`embedding`, {elapsed_ms:.1f} ms, `{len(chunks)}` chunks across `{len(file_metas) or len(texts)}` targets)",
        f"- **Query**: `{query}`{trunc_note}\n",
        "| Rank | Score | Target Coordinate | Ergonomics | Symbols |",
        "| :--- | :--- | :--- | :--- | :--- |",
    ]
    for rank, (score, c) in enumerate(top, start=1):
        fmeta = file_metas.get(c["path"])
        ergo = fmeta["ergonomics"] if fmeta else f"{c['end']}L"
        csyms = ", ".join(c["symbols"][:3]) if c["symbols"] else "(body)"
        link = f"[{c['name']}#L{c['start']}-L{c['end']}](file://{c['path']}#L{c['start']}-L{c['end']})" if fmeta else f"`{c['label']}`"
        out.append(f"| {rank} | `{score:.4f}` | {link} | `{ergo}` | `{csyms}` |")
    out.append("\n#### Pinned Context Slices & File Maps (Inline Execution Ready)")
    seen_meta: set[str] = set()
    for rank, (score, c) in enumerate(top, start=1):
        fmeta = file_metas.get(c["path"])
        hdr = f"**[{rank}] [{c['name']}#L{c['start']}-L{c['end']}](file://{c['path']}#L{c['start']}-L{c['end']})** (`score={score:.4f}`)"
        if fmeta and c["path"] not in seen_meta:
            seen_meta.add(c["path"])
            all_syms = ", ".join(fmeta["symbols"][:14]) if fmeta["symbols"] else "none"
            seams = ", ".join(fmeta["seams"]) if fmeta["seams"] else "none"
            hdr += f"\n- *Map (`{fmeta['lines']}L`, `{fmeta['ergonomics']}`, seams: `{seams}`)*: `{all_syms}`"
        out.append(f"{hdr}\n```text\n{c['numbered']}\n```")
    return core.fit_inline("\n".join(out))


if __name__ == "__main__":
    mcp.run()
