{
  "claire-tms-sync-reminder": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ak/projects/sdlc/hooks/tms-sync-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "claire-tms-doc-sync-stop": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "/home/ak/projects/sdlc/hooks/tms-doc-sync-stop.sh",
        "timeout": 15
      }
    ]
  }
}
