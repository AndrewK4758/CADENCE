{
  "global-local-offload-enforcer": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "/home/ak/.local/bin/antigravity-local-offload-hook",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ak/.local/bin/antigravity-local-offload-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
